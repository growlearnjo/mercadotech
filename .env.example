# URL del proyecto Supabase (Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública "anon" (Project Settings → API). Segura para exponer al
# navegador: todo el acceso a datos que habilita queda gobernado por RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave "service role" (Project Settings → API). BYPASEA RLS por completo.
# Nunca exponerla al cliente ni prefijarla con NEXT_PUBLIC_. Solo la usa
# lib/supabase/admin.ts, exclusivamente en código de servidor.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública del sitio (usada para redirects de auth, links en emails, etc.).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Hugging Face (sesión 4, nivel gratuito). Cuenta y token personales del
# alumno: Settings → Access Tokens → tipo "Read". Se pega SOLO en .env.local,
# nunca aquí ni en el chat.
HUGGINGFACEHUB_API_TOKEN=

# Modelo de embeddings (opcional). Default en código:
# sentence-transformers/all-MiniLM-L6-v2 (384 dimensiones). Cambiar la
# dimensión exige migración (ALTER COLUMN ... TYPE vector(N) + reindexar).
HUGGINGFACE_EMBEDDING_MODEL=

# Modelo de chat (opcional). Default en código: meta-llama/Llama-3.1-8B-Instruct.
# Los modelos gratuitos de Hugging Face rotan sin aviso: si el chat falla con
# "model not supported"/"no provider", reemplazar SOLO esta variable.
HUGGINGFACE_CHAT_MODEL=
